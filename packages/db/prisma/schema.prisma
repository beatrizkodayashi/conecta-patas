generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Ong {
  cnpjOng      String    @id @map("cnpj_ong")
  nomeOng      String    @map("nome_ong")
  email        String?
  telefone     String?
  endereco     String?
  responsavel  String?
  cidade       String?
  criadoEm     DateTime? @default(now()) @map("criado_em")
  atualizadoEm DateTime? @updatedAt @map("atualizado_em")

  pets     Pet[]
  adocoes  Adocao[]
  usuarios Usuario[]

  @@map("ong")
}

model Cliente {
  cpf                         String    @id
  nome                        String
  endereco                    String?
  email                       String?
  telefone                    String?
  statusAdocao                String?   @map("status_adocao")
  idAdocacao                  Int?      @map("id_adocacao")
  cidade                      String?
  tipoResidencia              String?   @map("tipo_residencia")
  temCriancas                 Boolean   @default(false) @map("tem_criancas")
  temIdosos                   Boolean   @default(false) @map("tem_idosos")
  temAdultos                  Boolean   @default(true) @map("tem_adultos")
  temOutrosAnimais            Boolean   @default(false) @map("tem_outros_animais")
  obsOutrosAnimais            String?   @map("obs_outros_animais")
  rotina                      String?
  especiePreferida            String?   @map("especie_preferida")
  portePreferido              String?   @map("porte_preferido")
  sexoPreferido               String?   @map("sexo_preferido")
  aceitaNecessidadesEspeciais Boolean   @default(false) @map("aceita_necessidades_especiais")
  criadoEm                    DateTime? @default(now()) @map("criado_em")
  atualizadoEm                DateTime? @updatedAt @map("atualizado_em")

  adocaoRef Adocao?   @relation("ClienteAdocaoRef", fields: [idAdocacao], references: [idAdocao], onDelete: SetNull, onUpdate: Cascade)
  adocoes   Adocao[]  @relation("AdocoesDoCliente")
  usuarios  Usuario[]

  @@index([idAdocacao], map: "idx_cliente_id_adocacao")
  @@map("cliente")
}

model Pet {
  idAnimal              Int       @id @default(autoincrement()) @map("id_animal")
  cnpjOng               String    @map("cnpj_ong")
  porte                 String?
  historico             String?
  idadeAprox            String?   @map("idade_aprox")
  tipoAnimal            String?   @map("tipo_animal")
  castrado              Boolean?  @default(false)
  microchipado          Boolean?  @default(false)
  statusAdocao          String?   @default("Disponível") @map("status_adocao")
  nomePet               String?   @map("nome_pet")
  sexo                  String?
  fotoUrl               String?   @map("foto_url")
  cidade                String?
  bomComCriancas        Boolean   @default(false) @map("bom_com_criancas")
  bomComAnimais         Boolean   @default(false) @map("bom_com_animais")
  necessidadesEspeciais Boolean   @default(false) @map("necessidades_especiais")
  obsNecessidades       String?   @map("obs_necessidades")
  vacinado              Boolean   @default(false)
  criadoEm              DateTime? @default(now()) @map("criado_em")
  atualizadoEm          DateTime? @updatedAt @map("atualizado_em")

  ong     Ong      @relation(fields: [cnpjOng], references: [cnpjOng], onDelete: Cascade, onUpdate: Cascade)
  adocoes Adocao[]

  @@index([cnpjOng], map: "idx_pet_cnpj_ong")
  @@index([statusAdocao], map: "idx_pet_status")
  @@map("pet")
}

model Adocao {
  idAdocao     Int       @id @default(autoincrement()) @map("id_adocao")
  idAnimal     Int       @map("id_animal")
  cpf          String
  cnpjOng      String    @map("cnpj_ong")
  statusAdocao String?   @default("Pendente") @map("status_adocao")
  criadoEm     DateTime? @default(now()) @map("criado_em")
  atualizadoEm DateTime? @updatedAt @map("atualizado_em")

  pet            Pet        @relation(fields: [idAnimal], references: [idAnimal], onDelete: Cascade, onUpdate: Cascade)
  cliente        Cliente    @relation("AdocoesDoCliente", fields: [cpf], references: [cpf], onDelete: Cascade, onUpdate: Cascade)
  ong            Ong        @relation(fields: [cnpjOng], references: [cnpjOng], onDelete: Cascade, onUpdate: Cascade)
  clientesComRef Cliente[]  @relation("ClienteAdocaoRef")
  mensagens      Mensagem[]

  @@index([idAnimal], map: "idx_adocao_id_animal")
  @@index([cpf], map: "idx_adocao_cpf")
  @@index([cnpjOng], map: "idx_adocao_cnpj_ong")
  @@map("adocao")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  senhaHash    String   @map("senha_hash")
  papel        String
  cpf          String?
  cnpjOng      String?  @map("cnpj_ong")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  cliente   Cliente?   @relation(fields: [cpf], references: [cpf], onDelete: Cascade, onUpdate: Cascade)
  ong       Ong?       @relation(fields: [cnpjOng], references: [cnpjOng], onDelete: Cascade, onUpdate: Cascade)
  mensagens Mensagem[]

  @@unique([cpf])
  @@unique([cnpjOng])
  @@map("usuario")
}

model Mensagem {
  id        Int      @id @default(autoincrement())
  idAdocao  Int      @map("id_adocao")
  idUsuario Int      @map("id_usuario")
  conteudo  String
  criadoEm  DateTime @default(now()) @map("criado_em")

  adocao  Adocao  @relation(fields: [idAdocao], references: [idAdocao], onDelete: Cascade, onUpdate: Cascade)
  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([idAdocao])
  @@map("mensagem")
}
