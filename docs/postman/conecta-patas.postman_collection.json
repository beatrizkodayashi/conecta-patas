{
  "info": {
    "name": "Conecta Patas API",
    "description": "Backend no banco Neon da colaboradora (ong, cliente, pet, adocao). Depois do login, copie o token para jwt.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "jwt", "value": "" },
    { "key": "petId", "value": "1" },
    { "key": "interestId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login ONG",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"contato@patinhasfelizes.org\",\n  \"password\": \"senha123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login adotante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria.silva@email.com\",\n  \"password\": \"senha123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Cadastrar adotante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"novo.adotante@conectapatas.com\",\n  \"password\": \"senha123\",\n  \"cpf\": \"999.999.999-99\",\n  \"nome\": \"Beatriz Teste\",\n  \"telefone\": \"(11) 98888-7777\",\n  \"endereco\": \"Rua A, 10\",\n  \"cidade\": \"Sao Paulo\",\n  \"tipoResidencia\": \"Casa\",\n  \"temCriancas\": true,\n  \"temIdosos\": false,\n  \"temAdultos\": true,\n  \"temOutrosAnimais\": false,\n  \"rotina\": \"Estudo e trabalho meio periodo\",\n  \"especiePreferida\": \"Cachorro\",\n  \"portePreferido\": \"Médio\",\n  \"aceitaNecessidadesEspeciais\": false\n}"
            },
            "url": "{{baseUrl}}/api/auth/register/adopter"
          }
        },
        {
          "name": "Cadastrar ONG",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nova.ong@conectapatas.com\",\n  \"password\": \"senha123\",\n  \"cnpjOng\": \"98.765.432/0001-10\",\n  \"nomeOng\": \"Amigos de Patas\",\n  \"responsavel\": \"Joao Pereira\",\n  \"telefone\": \"(11) 96666-5555\",\n  \"endereco\": \"Rua B, 20\",\n  \"cidade\": \"Sao Paulo\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register/ong"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Pets",
      "item": [
        {
          "name": "Listar disponiveis",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": "{{baseUrl}}/api/pets?tipoAnimal=Gato&cidade=Sao Paulo"
          }
        },
        {
          "name": "Ver ficha",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": "{{baseUrl}}/api/pets/{{petId}}"
          }
        },
        {
          "name": "Cadastrar pet",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomePet\": \"Nina\",\n  \"tipoAnimal\": \"Gato\",\n  \"sexo\": \"Femea\",\n  \"idadeAprox\": \"1 ano\",\n  \"porte\": \"Pequeno\",\n  \"historico\": \"Brincalhona e sociavel\",\n  \"bomComCriancas\": true,\n  \"bomComAnimais\": true,\n  \"necessidadesEspeciais\": false,\n  \"vacinado\": true,\n  \"castrado\": true,\n  \"fotoUrl\": \"https://placekitten.com/402/400\",\n  \"cidade\": \"Sao Paulo\"\n}"
            },
            "url": "{{baseUrl}}/api/pets"
          }
        },
        {
          "name": "Atualizar status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statusAdocao\": \"Em análise\"\n}"
            },
            "url": "{{baseUrl}}/api/pets/{{petId}}"
          }
        },
        {
          "name": "Arquivar pet",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": "{{baseUrl}}/api/pets/{{petId}}"
          }
        }
      ]
    },
    {
      "name": "Adotante",
      "item": [
        {
          "name": "Meu perfil",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": "{{baseUrl}}/api/adopters/me"
          }
        },
        {
          "name": "Meus interesses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": "{{baseUrl}}/api/adopters/me/interests"
          }
        }
      ]
    },
    {
      "name": "ONG",
      "item": [
        {
          "name": "Painel",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": "{{baseUrl}}/api/ongs/me/dashboard"
          }
        },
        {
          "name": "Meus pets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": "{{baseUrl}}/api/ongs/me/pets"
          }
        },
        {
          "name": "Interesses recebidos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": "{{baseUrl}}/api/ongs/me/interests"
          }
        }
      ]
    },
    {
      "name": "Interesses e mensagens",
      "item": [
        {
          "name": "Manifestar interesse",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idAnimal\": 1,\n  \"message\": \"Ola! Vi a ficha de saude e gostaria de adotar.\"\n}"
            },
            "url": "{{baseUrl}}/api/interests"
          }
        },
        {
          "name": "Ver interesse",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": "{{baseUrl}}/api/interests/{{interestId}}"
          }
        },
        {
          "name": "Concluir adocao",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statusAdocao\": \"Concluída\"\n}"
            },
            "url": "{{baseUrl}}/api/interests/{{interestId}}"
          }
        },
        {
          "name": "Enviar mensagem",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conteudo\": \"Podemos agendar uma visita?\"\n}"
            },
            "url": "{{baseUrl}}/api/interests/{{interestId}}/messages"
          }
        }
      ]
    }
  ]
}
